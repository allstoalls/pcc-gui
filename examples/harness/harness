#!/bin/sh
set -eu

PROJECT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
GUI_ROOT=$(CDPATH= cd -- "$PROJECT_DIR/../.." && pwd)
OUTPUT=$PROJECT_DIR/build/harness-core
NEEDS_BUILD=0

if [ ! -x "$OUTPUT" ]; then
    NEEDS_BUILD=1
else
    for SOURCE in "$PROJECT_DIR"/*.py "$PROJECT_DIR/build.sh" "$GUI_ROOT/pcc_gui"/*.py "$GUI_ROOT/pcc_gui/native/pcc_gui_metal_render_bridge.m"; do
        if [ "$SOURCE" -nt "$OUTPUT" ]; then
            NEEDS_BUILD=1
            break
        fi
    done
fi

if [ "$NEEDS_BUILD" -eq 1 ]; then
    "$PROJECT_DIR/build.sh"
fi

export PCC_HARNESS_GUI_BRIDGE=$PROJECT_DIR/build/libpcc_gui_metal.dylib
exec "$OUTPUT" "$@"
